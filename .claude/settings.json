{
  "permissions": {
    "deny": [
      "Read(**/*.jwk)",
      "Read(**/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --tags*)",
      "Bash(git push --mirror*)",
      "Bash(npm publish*)",
      "Bash(docker push*)",
      "Bash(gh release*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/guard.mjs" }]
      }
    ]
  }
}
