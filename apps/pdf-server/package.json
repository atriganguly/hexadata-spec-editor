{
  "name": "@hexadata/spec-pdf-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hardened Fastify + Puppeteer service that renders spec sheets to A4 PDF.",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "build": "tsup && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@hexadata/brand": "file:../../vendor/hexadata-brand-2.1.1.tgz",
    "@hexadata/spec-core": "*",
    "@hexadata/spec-templates": "*",
    "fastify": "^5.12.8",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lightningcss": "^1.33.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
